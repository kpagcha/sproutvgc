# The Pokémon Champions ranked regulation sproutvgc is up to date with, shown in the app and index.html.
# Regulation Set M-C runs from 9 September to 2 December 2026.
VITE_REGULATION=M-C

# The meta snapshots the app shows, by ID (`src/data/generated/meta/index.json` lists every one generated), the first
# by default. With more than one, pages with meta data let the reader pick. Smogon's are `smogon-<cutoff>`: 1760
# (strong players), 1630 (good players), 1500 (average players) and 0 (all players). On the dev server, the settings
# page has a section to try others in the browser, without touching this.
VITE_META_SETS=smogon-1760
