# The Pokémon Champions ranked regulation sproutvgc is up to date with, shown in the app and index.html.
# Regulation Set M-C runs from 9 September to 2 December 2026.
VITE_REGULATION=M-C

# The meta snapshots the app shows, by ID or pattern (`*` for anything), from those generated
# (`src/data/generated/meta/index.json`): every regulation in `scripts/sources.json`, every month of it. Smogon's are
# `smogon-<regulation>-<month>-<cutoff>`: 1760 (strong players), 1630 (good players), 1500 (average players) and 0
# (all players). The reader picks the regulation, month and players; the default is the current regulation's latest
# month, at the first cutoff listed. On the dev server, the settings page has a section to try others in the browser,
# without touching this.
VITE_META_SETS=smogon-*-1760,smogon-*-1630,smogon-*-1500,smogon-*-0
